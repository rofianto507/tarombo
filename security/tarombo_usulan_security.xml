<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Anggota: hanya lihat & buat usulan miliknya sendiri, dan hanya boleh
            menulis (edit) selama masih draft. Dua rule terpisah karena tiap rule
            hanya berlaku untuk operasi yang perm_*-nya True: rule pertama untuk
            read/create, rule kedua khusus write.
        -->
        <record id="rule_usulan_anggota_read_create" model="ir.rule">
            <field name="name">Usulan: anggota hanya lihat &amp; buat usulan sendiri</field>
            <field name="model_id" ref="model_tarombo_usulan"/>
            <field name="domain_force">[('pengusul_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_usulan_anggota_write_draft" model="ir.rule">
            <field name="name">Usulan: anggota hanya boleh ubah usulan sendiri selagi draft</field>
            <field name="model_id" ref="model_tarombo_usulan"/>
            <field name="domain_force">[('pengusul_id', '=', user.id), ('state', '=', 'draft')]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            Pengurus (dan admin, karena implies pengurus): akses penuh tanpa domain,
            meng-override rule anggota di atas lewat OR karena pengurus/admin juga
            otomatis anggota lewat implied_ids.
        -->
        <record id="rule_usulan_pengurus_semua" model="ir.rule">
            <field name="name">Usulan: pengurus lihat &amp; kelola semua usulan</field>
            <field name="model_id" ref="model_tarombo_usulan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_pengurus'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Anggota: hanya lihat & buat klaim miliknya sendiri. TIDAK ada rule
            write terpisah (beda dari tarombo.usulan) — klaim sengaja submit-once,
            kalau ditolak pengguna ajukan klaim baru, bukan mengedit yang lama.
            Ini menghindari race condition: pengguna mengubah orang_id sesudah
            pengurus mulai meninjau klaim yang sedang menunggu.
        -->
        <record id="rule_klaim_akun_anggota_read_create" model="ir.rule">
            <field name="name">Klaim Akun: anggota hanya lihat &amp; buat klaim sendiri</field>
            <field name="model_id" ref="model_tarombo_klaim_akun"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            Pengurus (dan admin, karena implies pengurus): akses penuh tanpa domain,
            meng-override rule anggota di atas lewat OR karena pengurus/admin juga
            otomatis anggota lewat implied_ids.
        -->
        <record id="rule_klaim_akun_pengurus_semua" model="ir.rule">
            <field name="name">Klaim Akun: pengurus lihat &amp; kelola semua klaim</field>
            <field name="model_id" ref="model_tarombo_klaim_akun"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_pengurus'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>

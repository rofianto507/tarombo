<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Anggota boleh menambah/mengubah/menghapus riwayat pendidikan & pekerjaan
            HANYA untuk profil yang tertaut ke akunnya sendiri (orang.user_id), tanpa
            persetujuan pengurus. Akses tulis di ir.model.access.csv sengaja dibuka
            untuk grup anggota, lalu DIBATASI di sini; perm_read=False supaya rule ini
            tidak menyempitkan baca (riwayat tetap terlihat oleh semua anggota seperti
            sebelumnya, dipakai Direktori Keahlian & profil).
        -->
        <record id="rule_pendidikan_anggota_milik_sendiri" model="ir.rule">
            <field name="name">Pendidikan: anggota hanya ubah riwayat miliknya sendiri</field>
            <field name="model_id" ref="model_tarombo_pendidikan"/>
            <field name="domain_force">[('orang_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_pendidikan_pengurus_semua" model="ir.rule">
            <field name="name">Pendidikan: pengurus kelola semua</field>
            <field name="model_id" ref="model_tarombo_pendidikan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_pengurus'))]"/>
        </record>

        <record id="rule_pekerjaan_anggota_milik_sendiri" model="ir.rule">
            <field name="name">Pekerjaan: anggota hanya ubah riwayat miliknya sendiri</field>
            <field name="model_id" ref="model_tarombo_pekerjaan"/>
            <field name="domain_force">[('orang_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_pekerjaan_pengurus_semua" model="ir.rule">
            <field name="name">Pekerjaan: pengurus kelola semua</field>
            <field name="model_id" ref="model_tarombo_pekerjaan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_pengurus'))]"/>
        </record>

    </data>
</odoo>

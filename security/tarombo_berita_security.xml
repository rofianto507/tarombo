<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Anggota hanya melihat berita/agenda yang sudah TERBIT; draft hanya
            untuk pengurus. Pengurus (dan admin via implied_ids) melihat semua.
        -->
        <record id="rule_berita_anggota_terbit" model="ir.rule">
            <field name="name">Berita: anggota hanya lihat yang terbit</field>
            <field name="model_id" ref="model_tarombo_berita"/>
            <field name="domain_force">[('state', '=', 'terbit')]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_berita_pengurus_semua" model="ir.rule">
            <field name="name">Berita: pengurus kelola semua</field>
            <field name="model_id" ref="model_tarombo_berita"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_pengurus'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Anggota cuma boleh lihat arsip yang ditandai publik=True. Field ini
            (tanpa rule ini) sebelumnya cuma dekorasi di form — ACL model-level
            tarombo.arsip memberi perm_read=1 ke SELURUH record, tanpa
            pengecualian row-level apa pun untuk arsip yang sengaja tidak
            publik. Pola sama seperti tarombo.usulan/tarombo.klaim_akun:
            pengurus (dan admin via implied_ids) meng-override lewat OR.
        -->
        <record id="rule_arsip_anggota_publik" model="ir.rule">
            <field name="name">Arsip: anggota hanya lihat yang publik</field>
            <field name="model_id" ref="model_tarombo_arsip"/>
            <field name="domain_force">['|', ('publik', '=', True), ('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!--
            Anggota menambah arsip ke PROFILNYA SENDIRI (orang.user_id = akun login)
            tanpa verifikasi pengurus, dan hanya boleh menghapus arsip yang ia unggah
            sendiri (create_uid) — arsip unggahan pengurus tidak bisa dihapus anggota.
            Read-nya mengikuti rule di atas: arsip miliknya tetap terlihat walau
            publik=False.
        -->
        <record id="rule_arsip_anggota_tambah_sendiri" model="ir.rule">
            <field name="name">Arsip: anggota tambah arsip ke profil sendiri</field>
            <field name="model_id" ref="model_tarombo_arsip"/>
            <field name="domain_force">[('orang_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_arsip_anggota_hapus_sendiri" model="ir.rule">
            <field name="name">Arsip: anggota hapus arsip unggahannya sendiri</field>
            <field name="model_id" ref="model_tarombo_arsip"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_anggota'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_arsip_pengurus_semua" model="ir.rule">
            <field name="name">Arsip: pengurus lihat &amp; kelola semua arsip</field>
            <field name="model_id" ref="model_tarombo_arsip"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_tarombo_pengurus'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tarombo.Dashboard">
        <Layout display="display">
            <t t-set-slot="layout-buttons">
                <button type="button" class="btn btn-sm btn-outline-primary" t-on-click="_muatData">
                    <i class="fa fa-refresh"/> Muat Ulang
                </button>
            </t>
            <t t-set-slot="control-panel-navigation-additional">
                <button type="button" class="btn btn-sm btn-primary o_tarombo_btn_pohon" t-on-click="_bukaPohonForce">
                    <i class="fa fa-share-alt"/> Visualisasi Pohon
                </button>
            </t>
            <div class="o_tarombo_dashboard" t-ref="root">
                <t t-if="state.loading">
                    <div class="o_tarombo_dashboard_status">
                        <i class="fa fa-spinner fa-spin fa-2x"/>
                        <div class="mt-2">Memuat dashboard...</div>
                    </div>
                </t>
                <t t-elif="state.error">
                    <div class="o_tarombo_dashboard_status text-muted">
                        Data dashboard tidak dapat dimuat.
                    </div>
                </t>
                <t t-else="">
                    <!-- KPI -->
                    <div class="o_tarombo_kpi_row">
                        <div class="o_tarombo_kpi_card o_tarombo_kpi_card--klik" role="button" title="Lihat daftar anggota"
                             t-on-click="() => this._bukaDaftar('tarombo.action_tarombo_orang')">
                            <div class="o_tarombo_kpi_icon"><i class="fa fa-users"/></div>
                            <div class="o_tarombo_kpi_body">
                                <div class="o_tarombo_kpi_value"><t t-esc="state.data.kpi.total_anggota"/></div>
                                <div class="o_tarombo_kpi_label">Total Anggota</div>
                                <div class="o_tarombo_kpi_sub">anggota tercatat</div>
                            </div>
                        </div>
                        <div class="o_tarombo_kpi_card o_tarombo_kpi_card--klik" role="button" title="Lihat anggota yang sudah terhubung akun"
                             t-on-click="() => this._bukaDaftar('tarombo.action_tarombo_orang', [['user_id', '!=', false]], 'Anggota Terhubung Akun')">
                            <div class="o_tarombo_kpi_icon"><i class="fa fa-check-circle"/></div>
                            <div class="o_tarombo_kpi_body">
                                <div class="o_tarombo_kpi_value"><t t-esc="state.data.kpi.terhubung_akun"/></div>
                                <div class="o_tarombo_kpi_label">Terhubung Akun</div>
                                <div class="o_tarombo_kpi_sub">terverifikasi, <t t-esc="state.data.kpi.persen_terhubung"/>% dari total</div>
                            </div>
                        </div>
                        <div class="o_tarombo_kpi_card o_tarombo_kpi_card--klik" role="button" title="Lihat usulan yang menunggu ditinjau"
                             t-on-click="() => this._bukaDaftar('tarombo.action_tarombo_usulan', [['state', '=', 'diajukan']], 'Usulan Menunggu')">
                            <div class="o_tarombo_kpi_icon"><i class="fa fa-clock-o"/></div>
                            <div class="o_tarombo_kpi_body">
                                <div class="o_tarombo_kpi_value"><t t-esc="state.data.kpi.usulan_menunggu"/></div>
                                <div class="o_tarombo_kpi_label">Usulan Menunggu</div>
                                <div class="o_tarombo_kpi_sub">perlu ditinjau</div>
                            </div>
                        </div>
                        <div class="o_tarombo_kpi_card">
                            <div class="o_tarombo_kpi_icon"><i class="fa fa-sitemap"/></div>
                            <div class="o_tarombo_kpi_body">
                                <div class="o_tarombo_kpi_value">
                                    <a href="#" class="o_tarombo_kpi_tautan" title="Lihat daftar punguan"
                                       t-on-click.prevent="() => this._bukaDaftar('tarombo.action_tarombo_punguan')"><t t-esc="state.data.kpi.total_punguan"/></a>
                                    /
                                    <a href="#" class="o_tarombo_kpi_tautan" title="Lihat daftar marga"
                                       t-on-click.prevent="() => this._bukaDaftar('tarombo.action_tarombo_marga')"><t t-esc="state.data.kpi.total_marga"/></a>
                                </div>
                                <div class="o_tarombo_kpi_label">Punguan / Marga</div>
                                <div class="o_tarombo_kpi_sub">terdaftar (klik angkanya)</div>
                            </div>
                        </div>
                    </div>

                    <!-- Chart baris 1 -->
                    <div class="o_tarombo_chart_row o_tarombo_chart_row--donut">
                        <div class="o_tarombo_chart_card">
                            <div class="o_tarombo_chart_title"><i class="fa fa-pie-chart"/> Distribusi Jenis Kelamin</div>
                            <t t-if="!state.data.jenis_kelamin.length">
                                <div class="o_tarombo_chart_empty">Tidak ada data</div>
                            </t>
                            <div t-else="" t-ref="donut" class="o_tarombo_chart_canvas"/>
                        </div>
                        <div class="o_tarombo_chart_card o_tarombo_chart_card--wide">
                            <div class="o_tarombo_chart_title"><i class="fa fa-line-chart"/> Anggota per Sundut (Generasi)</div>
                            <t t-if="!state.data.per_sundut.length">
                                <div class="o_tarombo_chart_empty">Tidak ada data</div>
                            </t>
                            <div t-else="" t-ref="sundut" class="o_tarombo_chart_canvas"/>
                        </div>
                    </div>

                    <!-- Chart baris 2 -->
                    <div class="o_tarombo_chart_row">
                        <div class="o_tarombo_chart_card">
                            <div class="o_tarombo_chart_title"><i class="fa fa-graduation-cap"/> Anggota per Pendidikan Tertinggi</div>
                            <t t-if="!state.data.per_pendidikan.length">
                                <div class="o_tarombo_chart_empty">Tidak ada data</div>
                            </t>
                            <div t-else="" t-ref="pendidikan" class="o_tarombo_chart_canvas"/>
                        </div>
                        <div class="o_tarombo_chart_card">
                            <div class="o_tarombo_chart_title"><i class="fa fa-briefcase"/> Anggota per Bidang Pekerjaan</div>
                            <t t-if="!state.data.per_bidang.length">
                                <div class="o_tarombo_chart_empty">Tidak ada data</div>
                            </t>
                            <div t-else="" t-ref="bidang" class="o_tarombo_chart_canvas"/>
                        </div>
                    </div>

                    <!-- Tabel -->
                    <div class="o_tarombo_table_row">
                        <!-- Ringkasan per domisili -->
                        <div class="o_tarombo_table_card">
                            <div class="o_tarombo_tbl_head">
                                <div class="o_tarombo_tbl_title"><i class="fa fa-map-marker"/> Ringkasan per Domisili</div>
                                <span class="o_tarombo_tbl_count"><t t-esc="state.data.tabel_domisili.length"/> wilayah</span>
                            </div>
                            <div class="o_tarombo_table_scroll">
                                <table class="o_tarombo_tbl">
                                    <thead>
                                        <tr>
                                            <th>Wilayah</th>
                                            <th class="text-end">Terverifikasi</th>
                                            <th class="text-end">Belum</th>
                                            <th class="text-end">Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="!state.data.tabel_domisili.length">
                                            <tr><td colspan="4" class="o_tarombo_tbl_kosong">Belum ada data domisili</td></tr>
                                        </t>
                                        <t t-foreach="state.data.tabel_domisili" t-as="row" t-key="row.id">
                                            <t t-set="bagian" t-value="row.name.split(' - ')"/>
                                            <tr class="o_tarombo_row_klik" t-on-click="() => this._bukaDomisili(row)" title="Lihat anggota di wilayah ini">
                                                <td class="o_tarombo_tbl_wilayah">
                                                    <div class="o_tarombo_tbl_utama">
                                                        <t t-if="bagian.length > 1"><t t-esc="bagian.slice(1).join(' - ')"/></t>
                                                        <t t-else=""><t t-esc="row.name"/></t>
                                                    </div>
                                                    <div t-if="bagian.length > 1" class="o_tarombo_tbl_sub"><t t-esc="bagian[0]"/></div>
                                                    <div class="o_tarombo_tbl_bar"><span t-attf-style="width: #{Math.round(row.total * 100 / maksDomisili)}%"/></div>
                                                </td>
                                                <td class="text-end">
                                                    <span t-attf-class="o_tarombo_pil #{row.terverifikasi ? 'o_tarombo_pil--hijau' : 'o_tarombo_pil--nol'}"><t t-esc="row.terverifikasi"/></span>
                                                </td>
                                                <td class="text-end">
                                                    <span t-attf-class="o_tarombo_pil #{row.rumpang ? 'o_tarombo_pil--emas' : 'o_tarombo_pil--nol'}"><t t-esc="row.rumpang"/></span>
                                                </td>
                                                <td class="text-end o_tarombo_tbl_total"><t t-esc="row.total"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Usulan menunggu tinjauan -->
                        <div class="o_tarombo_table_card">
                            <div class="o_tarombo_tbl_head">
                                <div class="o_tarombo_tbl_title">
                                    <i class="fa fa-clock-o"/> Usulan Menunggu Tinjauan
                                    <span class="o_tarombo_tbl_count o_tarombo_tbl_count--emas"><t t-esc="state.data.kpi.usulan_menunggu"/></span>
                                </div>
                                <a href="#" class="o_tarombo_tbl_semua"
                                   t-on-click.prevent="() => this._bukaDaftar('tarombo.action_tarombo_usulan', [['state', '=', 'diajukan']], 'Usulan Menunggu')">Lihat semua <i class="fa fa-angle-right"/></a>
                            </div>
                            <div class="o_tarombo_table_scroll">
                                <table class="o_tarombo_tbl">
                                    <thead>
                                        <tr>
                                            <th>Usulan</th>
                                            <th>Jenis</th>
                                            <th>Sasaran</th>
                                            <th class="text-end">Diajukan</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="!state.data.usulan_menunggu_list.length">
                                            <tr><td colspan="4" class="o_tarombo_tbl_kosong"><i class="fa fa-check-circle"/> Tidak ada usulan yang menunggu</td></tr>
                                        </t>
                                        <t t-foreach="state.data.usulan_menunggu_list" t-as="row" t-key="row.id">
                                            <tr class="o_tarombo_row_klik" t-on-click="() => this._bukaUsulan(row.id)" title="Buka usulan">
                                                <td class="o_tarombo_tbl_kode"><t t-esc="row.name"/></td>
                                                <td><span t-attf-class="o_tarombo_pil #{this._kelasJenis(row.jenis)}"><t t-esc="row.jenis"/></span></td>
                                                <td class="o_tarombo_tbl_utama"><t t-esc="row.sasaran"/></td>
                                                <td class="text-end o_tarombo_tbl_tgl"><t t-esc="row.tanggal_ajukan"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Peta -->
                    <div class="o_tarombo_map_card">
                        <div class="o_tarombo_chart_title">
                            <i class="fa fa-map-marker"/> Sebaran Anggota per Wilayah
                            <span class="ms-3 btn-group btn-group-sm" role="group">
                                <button type="button" class="btn"
                                        t-att-class="state.levelPeta === 'provinsi' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setLevelPeta('provinsi')">Provinsi</button>
                                <button type="button" class="btn"
                                        t-att-class="state.levelPeta === 'kabupaten' ? 'btn-primary' : 'btn-outline-secondary'"
                                        t-on-click="() => this.setLevelPeta('kabupaten')">Kabupaten/Kota</button>
                            </span>
                        </div>
                        <t t-if="!state.data.sebaran_wilayah.provinsi.length and !state.data.sebaran_wilayah.kabupaten.length">
                            <div class="o_tarombo_chart_empty">Belum ada anggota yang mengisi domisili.</div>
                        </t>
                        <div t-else="" t-ref="map" class="o_tarombo_map_canvas"/>
                    </div>

                    <!-- Kanban arsip -->
                    <div class="o_tarombo_kanban_section">
                        <div class="o_tarombo_chart_title"><i class="fa fa-th-large"/> Arsip Terbaru</div>
                        <t t-if="!state.data.arsip_terbaru.length">
                            <div class="o_tarombo_chart_empty">Belum ada arsip.</div>
                        </t>
                        <div t-else="" class="o_tarombo_kanban_grid">
                            <t t-foreach="state.data.arsip_terbaru" t-as="item" t-key="item.id">
                                <div class="o_tarombo_kanban_card" t-on-click="() => this._bukaArsip(item.id)">
                                    <div class="o_tarombo_kanban_thumb">
                                        <img t-if="item.punya_foto" t-att-src="_urlPratinjau(item.id)" alt=""/>
                                        <i t-else="" class="fa fa-file-o fa-2x"/>
                                    </div>
                                    <div class="o_tarombo_kanban_body">
                                        <div class="o_tarombo_kanban_name" t-esc="item.name"/>
                                        <div class="o_tarombo_kanban_sub">
                                            <t t-esc="item.jenis"/> · <t t-esc="item.orang"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </Layout>
    </t>

</templates>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_tarombo_masukan_list" model="ir.ui.view">
            <field name="name">tarombo.masukan.list</field>
            <field name="model">tarombo.masukan</field>
            <field name="arch" type="xml">
                <list string="Masukan" decoration-danger="kategori == 'anak' and state == 'baru'"
                      decoration-warning="state == 'baru'" decoration-muted="state == 'ditangani'">
                    <field name="create_date" string="Diterima"/>
                    <field name="kategori"/>
                    <field name="isi"/>
                    <field name="user_id"/>
                    <field name="versi_app" optional="hide"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_tarombo_masukan_form" model="ir.ui.view">
            <field name="name">tarombo.masukan.form</field>
            <field name="model">tarombo.masukan</field>
            <field name="arch" type="xml">
                <form string="Masukan" create="false">
                    <header>
                        <button name="action_tandai_ditangani" type="object" string="Tandai Ditangani"
                                class="btn-primary" invisible="state != 'baru'"/>
                        <field name="state" widget="statusbar" statusbar_visible="baru,ditangani"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="kategori"/>
                                <field name="user_id"/>
                                <field name="versi_app"/>
                            </group>
                            <group>
                                <field name="penangan_id"/>
                                <field name="tanggal_tangani"/>
                            </group>
                        </group>
                        <group string="Isi Masukan">
                            <field name="isi" nolabel="1" colspan="2" readonly="1"/>
                        </group>
                        <group string="Catatan Pengurus">
                            <field name="catatan_pengurus" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_tarombo_masukan_search" model="ir.ui.view">
            <field name="name">tarombo.masukan.search</field>
            <field name="model">tarombo.masukan</field>
            <field name="arch" type="xml">
                <search string="Cari Masukan">
                    <field name="isi"/>
                    <field name="user_id"/>
                    <filter string="Baru" name="filter_baru" domain="[('state', '=', 'baru')]"/>
                    <filter string="Keselamatan Anak" name="filter_anak" domain="[('kategori', '=', 'anak')]"/>
                    <group>
                        <filter string="Kategori" name="groupby_kategori" context="{'group_by': 'kategori'}"/>
                        <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_tarombo_masukan" model="ir.actions.act_window">
            <field name="name">Masukan Pengguna</field>
            <field name="res_model">tarombo.masukan</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_tarombo_masukan_search"/>
            <field name="context">{'search_default_filter_baru': 1}</field>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_tarombo_padan_list" model="ir.ui.view">
            <field name="name">tarombo.padan.list</field>
            <field name="model">tarombo.padan</field>
            <field name="arch" type="xml">
                <list string="Padan">
                    <field name="name"/>
                    <field name="marga_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_tarombo_padan_form" model="ir.ui.view">
            <field name="name">tarombo.padan.form</field>
            <field name="model">tarombo.padan</field>
            <field name="arch" type="xml">
                <form string="Padan">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="mis. Hutabarat - Silaban"/></h1>
                        </div>
                        <group>
                            <field name="marga_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Keterangan">
                            <field name="keterangan" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_tarombo_padan" model="ir.actions.act_window">
            <field name="name">Padan</field>
            <field name="res_model">tarombo.padan</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>

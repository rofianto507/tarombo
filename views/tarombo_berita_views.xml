<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- LIST -->
        <record id="view_tarombo_berita_list" model="ir.ui.view">
            <field name="name">tarombo.berita.list</field>
            <field name="model">tarombo.berita</field>
            <field name="arch" type="xml">
                <list string="Berita &amp; Agenda" decoration-muted="state == 'draft'">
                    <field name="name"/>
                    <field name="jenis"/>
                    <field name="tanggal_mulai" optional="show"/>
                    <field name="lokasi" optional="hide"/>
                    <field name="tanggal_terbit"/>
                    <field name="jumlah_komentar" string="Komentar"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <!-- KANBAN: per status, kartu bergambar sampul -->
        <record id="view_tarombo_berita_kanban" model="ir.ui.view">
            <field name="name">tarombo.berita.kanban</field>
            <field name="model">tarombo.berita</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" group_create="false" group_delete="false"
                        group_edit="false" records_draggable="false">
                    <field name="gambar"/>
                    <field name="jenis"/>
                    <field name="tanggal_mulai"/>
                    <templates>
                        <t t-name="card">
                            <div class="d-flex align-items-center justify-content-center bg-light overflow-hidden"
                                 style="height: 140px;">
                                <field name="gambar" widget="image"
                                       options="{'img_class': 'w-100 h-100 object-fit-cover'}"
                                       alt="Sampul" invisible="not gambar"/>
                                <i class="fa fa-newspaper-o fa-3x text-muted" invisible="gambar"/>
                            </div>
                            <div class="p-2">
                                <strong><field name="name"/></strong>
                                <div class="mt-1">
                                    <field name="jenis" widget="badge"
                                           decoration-info="jenis == 'berita'"
                                           decoration-warning="jenis == 'agenda'"/>
                                </div>
                                <div class="text-muted small mt-1" t-if="record.jenis.raw_value === 'agenda' &amp;&amp; record.tanggal_mulai.raw_value">
                                    <i class="fa fa-calendar"/> <field name="tanggal_mulai"/>
                                </div>
                                <div class="text-muted small" t-if="record.tanggal_terbit.raw_value">
                                    Terbit: <field name="tanggal_terbit"/>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- GRAPH: jumlah per bulan terbit, dipecah menurut jenis -->
        <record id="view_tarombo_berita_graph" model="ir.ui.view">
            <field name="name">tarombo.berita.graph</field>
            <field name="model">tarombo.berita</field>
            <field name="arch" type="xml">
                <graph string="Berita &amp; Agenda" type="bar" stacked="1">
                    <field name="tanggal_terbit" interval="month"/>
                    <field name="jenis"/>
                </graph>
            </field>
        </record>

        <!-- PIVOT: jenis x status -->
        <record id="view_tarombo_berita_pivot" model="ir.ui.view">
            <field name="name">tarombo.berita.pivot</field>
            <field name="model">tarombo.berita</field>
            <field name="arch" type="xml">
                <pivot string="Berita &amp; Agenda">
                    <field name="jenis" type="row"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- FORM -->
        <record id="view_tarombo_berita_form" model="ir.ui.view">
            <field name="name">tarombo.berita.form</field>
            <field name="model">tarombo.berita</field>
            <field name="arch" type="xml">
                <form string="Berita &amp; Agenda">
                    <header>
                        <button name="action_terbitkan" type="object" string="Terbitkan"
                                class="btn-primary" invisible="state != 'draft'"
                                confirm="Terbitkan sekarang? Anggota yang akunnya sudah tertaut akan menerima notifikasi."/>
                        <button name="action_tarik" type="object" string="Tarik ke Draft"
                                invisible="state != 'terbit'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,terbit"/>
                    </header>
                    <sheet>
                        <field name="gambar" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Judul"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="jenis" widget="radio" options="{'horizontal': true}"/>
                                <field name="penulis_id"/>
                                <field name="tanggal_terbit"/>
                            </group>
                            <group invisible="jenis != 'agenda'">
                                <field name="tanggal_mulai" required="jenis == 'agenda'"/>
                                <field name="tanggal_selesai"/>
                                <field name="lokasi"/>
                            </group>
                        </group>
                        <group string="Ringkasan (tampil di beranda)">
                            <field name="ringkasan" nolabel="1" colspan="2"/>
                        </group>
                        <group string="Isi">
                            <field name="isi" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- SEARCH -->
        <record id="view_tarombo_berita_search" model="ir.ui.view">
            <field name="name">tarombo.berita.search</field>
            <field name="model">tarombo.berita</field>
            <field name="arch" type="xml">
                <search string="Cari Berita &amp; Agenda">
                    <field name="name"/>
                    <filter string="Berita" name="filter_berita" domain="[('jenis', '=', 'berita')]"/>
                    <filter string="Agenda" name="filter_agenda" domain="[('jenis', '=', 'agenda')]"/>
                    <separator/>
                    <filter string="Terbit" name="filter_terbit" domain="[('state', '=', 'terbit')]"/>
                    <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                    <group>
                        <filter string="Jenis" name="groupby_jenis" context="{'group_by': 'jenis'}"/>
                        <filter string="Status" name="groupby_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_tarombo_berita" model="ir.actions.act_window">
            <field name="name">Berita &amp; Agenda</field>
            <field name="res_model">tarombo.berita</field>
            <field name="view_mode">list,kanban,graph,pivot,form</field>
            <field name="search_view_id" ref="view_tarombo_berita_search"/>
        </record>

    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_tarombo_punguan_list" model="ir.ui.view">
            <field name="name">tarombo.punguan.list</field>
            <field name="model">tarombo.punguan</field>
            <field name="arch" type="xml">
                <list string="Punguan">
                    <field name="name"/>
                    <field name="kode" optional="hide"/>
                    <field name="wilayah_id"/>
                    <field name="jumlah_anggota"/>
                    <field name="aktif"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_tarombo_punguan_form" model="ir.ui.view">
            <field name="name">tarombo.punguan.form</field>
            <field name="model">tarombo.punguan</field>
            <field name="arch" type="xml">
                <form string="Punguan">
                    <sheet>
                        <widget name="web_ribbon" title="Nonaktif" bg_color="text-bg-danger" invisible="aktif"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nama Punguan"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="kode"/>
                                <field name="wilayah_id"/>
                                <field name="aktif"/>
                            </group>
                            <group>
                                <field name="jumlah_anggota"/>
                                <field name="pengurus_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Keterangan">
                            <field name="keterangan" nolabel="1" colspan="2"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_tarombo_punguan" model="ir.actions.act_window">
            <field name="name">Punguan</field>
            <field name="res_model">tarombo.punguan</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>

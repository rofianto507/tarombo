<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- LIST VIEW -->
        <record id="view_tarombo_bidang_list" model="ir.ui.view">
            <field name="name">tarombo.bidang.list</field>
            <field name="model">tarombo.bidang</field>
            <field name="arch" type="xml">
                <list string="Bidang" editable="bottom">
                    <field name="name"/>
                    <field name="keterangan"/>
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_tarombo_bidang_form" model="ir.ui.view">
            <field name="name">tarombo.bidang.form</field>
            <field name="model">tarombo.bidang</field>
            <field name="arch" type="xml">
                <form string="Bidang">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="Nama Bidang"/></h1>
                        </div>
                        <group>
                            <field name="keterangan"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_tarombo_bidang_search" model="ir.ui.view">
            <field name="name">tarombo.bidang.search</field>
            <field name="model">tarombo.bidang</field>
            <field name="arch" type="xml">
                <search string="Cari Bidang">
                    <field name="name"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_tarombo_bidang" model="ir.actions.act_window">
            <field name="name">Bidang</field>
            <field name="res_model">tarombo.bidang</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_tarombo_bidang_search"/>
        </record>

    </data>
</odoo>

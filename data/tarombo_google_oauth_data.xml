<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Aktifkan provider Google bawaan auth_oauth untuk login Google dari
             app mobile (lihat controllers/mobile_auth.py: google_login()).
             client_id di sini TIDAK dipakai oleh alur validasi milik kita
             sendiri (yang cuma memvalidasi access_token langsung ke endpoint
             userinfo Google, tanpa cek audience seperti alur redirect web
             bawaan Odoo) — diisi untuk kelengkapan/dokumentasi saja, sesuai
             OAuth Client ID Android yang didaftarkan di Google Cloud Console
             untuk paket id.selstudio.tarombo_mobile.

             SENGAJA pakai <function> write(), BUKAN <record> override biasa:
             auth_oauth mendaftarkan provider_google dengan noupdate="1" di
             modulnya sendiri, jadi <record> dengan xmlid yang sama di sini
             DIAM-DIAM DIABAIKAN Odoo (flag noupdate yang berlaku adalah yang
             TERSIMPAN di ir.model.data record aslinya, bukan pengaturan file
             ini) — persis bug yang sempat kejadian saat pertama kali ditulis
             pakai <record>. Pola <function> ini sama persis dengan yang
             dipakai auth_oauth sendiri untuk set client_id provider_openerp
             di auth_oauth_data.xml. -->
        <function model="auth.oauth.provider" name="write">
            <value eval="[ref('auth_oauth.provider_google')]"/>
            <value eval="{
                'client_id': '593020162144-nasbg9mu0j9gs97flro10l3dfueqaj1d.apps.googleusercontent.com',
                'enabled': True,
            }"/>
        </function>

    </data>
</odoo>
